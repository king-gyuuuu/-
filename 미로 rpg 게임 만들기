    // --- Maze Generator (For Endless Mode) ---
    class MazeGenerator {
        constructor(level) {
            const sizeIncrement = Math.min(level * 2, 60); 
            this.width = 9 + sizeIncrement;
            this.height = 9 + sizeIncrement;
            if (this.width % 2 === 0) this.width++;
            if (this.height % 2 === 0) this.height++;
            this.map = [];
        }

        generate() {
            for (let y = 0; y < this.height; y++) {
                let row = [];
                for (let x = 0; x < this.width; x++) { row.push('#'); }
                this.map.push(row);
            }
            const startX = 1; const startY = 1;
            this.carve(startX, startY);
            this.map[1][1] = 'S';
            let exitPlaced = false;
            for (let y = this.height - 2; y > 0 && !exitPlaced; y--) {
                for (let x = this.width - 2; x > 0 && !exitPlaced; x--) {
                    if (this.map[y][x] === '.') { this.map[y][x] = 'E'; exitPlaced = true; }
                }
            }
            let coinCount = Math.floor((this.width * this.height) / 20); 
            let attempts = 0;
            while (coinCount > 0 && attempts < 1000) {
                const rx = Phaser.Math.Between(1, this.width - 2);
                const ry = Phaser.Math.Between(1, this.height - 2);
                if (this.map[ry][rx] === '.') { this.map[ry][rx] = 'C'; coinCount--; }
                attempts++;
            }
            return this.map;
        }

        carve(x, y) {
            const directions = [{ dx: 0, dy: -2 }, { dx: 0, dy: 2 }, { dx: -2, dy: 0 }, { dx: 2, dy: 0 }];
            directions.sort(() => Math.random() - 0.5);
            this.map[y][x] = '.';
            for (let dir of directions) {
                const nx = x + dir.dx;
                const ny = y + dir.dy;
                if (nx > 0 && nx < this.width - 1 && ny > 0 && ny < this.height - 1 && this.map[ny][nx] === '#') {
                    this.map[y + dir.dy / 2][x + dir.dx / 2] = '.';
                    this.carve(nx, ny);
                }
            }
        }
    }

    // --- Helper: Create Button ---
    function createButton(scene, x, y, text, style = {}) {
        const container = scene.add.container(x, y);
        const bgColor = style.backgroundColor || 0x3498db;
        const hoverColor = style.hoverColor || Phaser.Display.Color.HexStringToColor('#' + bgColor.toString(16).padStart(6, '0')).lighten(20).color;
        const textColor = style.color || '#ffffff';
        const padding = style.padding || { x: 20, y: 12 };
        const borderRadius = style.borderRadius || 12;
        const fontSize = style.fontSize || '24px';
        const shadowOffset = style.shadowOffset || 4;

        const buttonText = scene.add.text(0, 0, text, {
            fontFamily: 'Do Hyeon', fontSize: fontSize, color: textColor,
            stroke: style.stroke || '#000000', strokeThickness: style.strokeThickness || 0
        }).setOrigin(0.5);

        const buttonWidth = buttonText.width + padding.x * 2;
        const buttonHeight = buttonText.height + padding.y * 2;
        
        const shadow = scene.add.graphics();
        shadow.fillStyle(0x000000, 0.4);
        shadow.fillRoundedRect(-buttonWidth / 2 + shadowOffset, -buttonHeight / 2 + shadowOffset, buttonWidth, buttonHeight, borderRadius);

        const bg = scene.add.graphics();
        bg.fillStyle(bgColor, 1);
        bg.fillRoundedRect(-buttonWidth / 2, -buttonHeight / 2, buttonWidth, buttonHeight, borderRadius);
        
        if (style.showBorder !== false) {
            bg.lineStyle(2, 0xffffff, 0.3);
            bg.strokeRoundedRect(-buttonWidth / 2, -buttonHeight / 2, buttonWidth, buttonHeight, borderRadius);
        }
        
        container.add([shadow, bg, buttonText]);
        container.setSize(buttonWidth, buttonHeight);
        container.setInteractive({ useHandCursor: true });

        container.on('pointerover', () => {
            scene.tweens.add({ targets: container, scale: 1.05, duration: 100, ease: 'Back.easeOut' });
            bg.clear(); bg.fillStyle(hoverColor, 1);
            bg.fillRoundedRect(-buttonWidth / 2, -buttonHeight / 2, buttonWidth, buttonHeight, borderRadius);
            if (style.showBorder !== false) { bg.lineStyle(2, 0xffffff, 0.5); bg.strokeRoundedRect(-buttonWidth / 2, -buttonHeight / 2, buttonWidth, buttonHeight, borderRadius); }
        });

        container.on('pointerout', () => {
            scene.tweens.add({ targets: container, scale: 1, duration: 100, ease: 'Back.easeIn' });
            bg.clear(); bg.fillStyle(bgColor, 1);
            bg.fillRoundedRect(-buttonWidth / 2, -buttonHeight / 2, buttonWidth, buttonHeight, borderRadius);
            if (style.showBorder !== false) { bg.lineStyle(2, 0xffffff, 0.3); bg.strokeRoundedRect(-buttonWidth / 2, -buttonHeight / 2, buttonWidth, buttonHeight, borderRadius); }
        });

        container.on('pointerdown', () => {
            scene.tweens.add({ targets: container, scale: 0.95, duration: 50, yoyo: true });
        });
        
        return container;
    }

    // --- Audio Manager ---
    function manageBGM(scene, targetMode) {
        if (synthInterval) { clearInterval(synthInterval); synthInterval = null; }
        if (scene.sound.locked) scene.sound.unlock();

        let targetKey = '';
        if (targetMode === 'timeAttack') { targetKey = 'track_miro'; } 
        else { targetKey = 'track_bgm'; } 

        if (globalBGM.key === targetKey && globalBGM.instance && globalBGM.instance.isPlaying) {
            globalBGM.instance.setVolume(0.5 * bgmVolume); return; 
        }

        if (globalBGM.instance) {
            globalBGM.instance.stop(); globalBGM.instance.destroy(); globalBGM.instance = null; globalBGM.key = null;
        }

        if (scene.cache.audio.exists(targetKey)) {
            globalBGM.instance = scene.sound.add(targetKey, { loop: true, volume: 0.5 * bgmVolume });
            globalBGM.instance.play(); globalBGM.key = targetKey;
        } else {
            startSynthBGM(scene, targetKey);
        }
    }

    function startSynthBGM(scene, key) {
        const ctx = scene.sound.context; if (!ctx) return;
        const notes = key === 'track_bgm' ? [261.63, 329.63, 392.00, 493.88] : [220.00, 261.63, 329.63, 415.30];
        let idx = 0;
        synthInterval = setInterval(() => {
            if (ctx.state === 'suspended' || bgmVolume <= 0) return;
            const osc = ctx.createOscillator(); const gain = ctx.createGain();
            osc.connect(gain); gain.connect(ctx.destination);
            const now = ctx.currentTime;
            osc.frequency.setValueAtTime(notes[idx], now);
            gain.gain.setValueAtTime(0, now);
            gain.gain.linearRampToValueAtTime(0.1 * bgmVolume, now + 0.1);
            gain.gain.linearRampToValueAtTime(0, now + 0.3);
            osc.start(now); osc.stop(now + 0.3);
            idx = (idx + 1) % notes.length;
        }, 500);
    }

