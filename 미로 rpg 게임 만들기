            this.input.once('pointerdown', () => { if (this.sound.context.state === 'suspended') this.sound.context.resume(); });
        }

        startGame(mode) {
            gameMode = mode;
            const currentSkin = SKINS.find(s => s.color === playerData.skin) || SKINS[0];
            if (mode === 'timeAttack') {
                timeLeft = 120;
                if (currentSkin.ability === 'time_bonus' || currentSkin.ability === 'ultimate') { timeLeft += 30; }
            }
            if (mode === 'endless') {
                playerData.lives = 3;
                if (currentSkin.ability === 'extra_life' || currentSkin.ability === 'ultimate') { playerData.lives = 4; }
            }
            currentLevel = 0;
            this.cameras.main.fadeOut(300, 0, 0, 0);
            this.time.delayedCall(300, () => { this.scene.stop('UIScene'); this.scene.start('GameScene'); });
