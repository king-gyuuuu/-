        showHowToPlay() {
            const { width, height } = this.sys.game.config; const overlay = this.add.rectangle(0, 0, width, height, 0x000000, 0.8).setOrigin(0); const centerX = width / 2, centerY = height / 2;
            const panel = this.add.graphics(); panel.fillStyle(0x2c3e50, 1); panel.lineStyle(3, 0x3498db, 1); panel.fillRoundedRect(centerX - 300, centerY - 250, 600, 500, 20); panel.strokeRoundedRect(centerX - 300, centerY - 250, 600, 500, 20);
            const title = this.add.text(centerX, centerY - 200, '🎮 게임 방법', { fontFamily: 'Do Hyeon', fontSize: '40px', color: '#ecf0f1' }).setOrigin(0.5);
            const instructions = [
                '🎯 목표: 출구(녹색)에 도달하세요!', '', '🕹️ 조작법: 화살표 키 또는 W,A,S,D', '',
                '❤️ 무한 모드: 하트 3개로 최대한 멀리!', '⏱️ 타임 어택: 제한시간 내 클리어', '',
                '🔴 주의: 레벨 20부터 움직이는 장애물 등장!'
            ];
            let yPos = centerY - 140; instructions.forEach(line => { this.add.text(centerX - 250, yPos, line, { fontFamily: 'Do Hyeon', fontSize: '18px', color: '#ecf0f1', lineSpacing: 5 }); yPos += 30; });
            const closeButton = createButton(this, centerX, centerY + 210, '닫기', { fontSize: '28px', backgroundColor: 0x27ae60 });
            closeButton.on('pointerdown', () => { overlay.destroy(); panel.destroy(); title.destroy(); this.scene.restart(); });
        }
        update() {
            if (!this.particles) return;
            this.particles.children.iterate((p) => {
                p.y -= p.speedY; p.x += p.speedX; 
                if (p.y < -20) { p.y = this.sys.game.config.height + 20; p.x = Math.random() * this.sys.game.config.width; }
                if (p.x < -20) p.x = this.sys.game.config.width + 20;
                if (p.x > this.sys.game.config.width + 20) p.x = -20;
            });
        }
    }

    // --- Game Scene ---
    class GameScene extends Phaser.Scene {
        constructor() { super("GameScene"); }

        create() {
            manageBGM(this, gameMode);
            
            const { width, height } = this.sys.game.config;
            
            const levelText = this.add.text(width / 2, height / 2, `Level ${currentLevel + 1}`, { 
                fontFamily: 'Do Hyeon', fontSize: '48px', color: '#ffffff',
                stroke: '#000000', strokeThickness: 6
            }).setOrigin(0.5).setScrollFactor(0).setDepth(2).setScale(0);
            
            this.tweens.add({ targets: levelText, scale: 1.2, duration: 300, ease: 'Back.easeOut' });
            this.tweens.add({ targets: levelText, alpha: 0, scale: 0.8, duration: 1000, delay: 1000, ease: 'Power2', onComplete: () => { levelText.destroy(); } });

            this.isPlayerLocked = false;
            this.isInvincible = false;
            this.shieldTimer = null;
            this.speedBoostTimer = null;
            this.speedBoostMultiplier = 1.0;

            const currentSkin = SKINS.find(s => s.color === playerData.skin) || SKINS[0];
            if (currentSkin.ability === 'ninja') { this.speedBoostMultiplier = 1.3; }
            else if (currentSkin.ability === 'start_rich' && currentLevel === 0 && !this.richBonusGiven) {
                playerData.coins += 5; this.richBonusGiven = true;
            }

            // [FIX] Map Generation Strategy
            let mapData;
            if (gameMode === 'timeAttack') {
                // 타임 어택은 고정 맵 사용 (루프)
                const levelIndex = currentLevel % LEVELS.length;
                mapData = LEVELS[levelIndex];
            } else {
                // 무한 모드는 랜덤 생성
                this.generator = new MazeGenerator(currentLevel);
                mapData = this.generator.generate();
            }
            
            this.makeLevel(mapData);

            this.cursors = this.input.keyboard.createCursorKeys();
            this.keys = this.input.keyboard.addKeys("W,A,S,D");
            this.cameras.main.startFollow(this.player).setBounds(0, 0, this.cols * TILE, this.rows * TILE).setZoom(2);
            this.scene.launch('UIScene');

            if (gameMode === 'endless') {
                this.fog = this.add.rectangle(0, 0, this.cols * TILE, this.rows * TILE, 0x000000, 1).setOrigin(0,0).setDepth(1);
                this.vision = this.make.graphics();
                this.vision.setVisible(false);
                this.fog.mask = new Phaser.Display.Masks.GeometryMask(this, this.vision);
                this.fog.mask.invertAlpha = true;
            }
            this.setupAbility();
            this.cameras.main.fadeIn(300, 0, 0, 0);
        }

        makeLevel(levelMap) {
            this.rows = levelMap.length; this.cols = levelMap[0].length;
            this.cameras.main.setBackgroundColor("#0a0a0a");
            this.walls = this.physics.add.staticGroup(); 
            this.exits = this.physics.add.staticGroup(); 
            this.coins = this.physics.add.group();
            this.enemies = this.physics.add.group({
                bounceX: 1,
                bounceY: 1,
                collideWorldBounds: true
            });

            let startPos = { x: 1, y: 1 };
            for (let y = 0; y < this.rows; y++) { 
                for (let x = 0; x < this.cols; x++) {
                    const ch = levelMap[y][x], px = x * TILE + TILE / 2, py = y * TILE + TILE / 2;
                    if (ch === "#") { 
                        const wall = this.add.rectangle(px, py, TILE, TILE, 0x3498db); 
                        wall.setStrokeStyle(1, 0x2980b9, 0.5); 
                        this.physics.add.existing(wall, true); 
                        this.walls.add(wall); 
                    }
                    else if (ch === "S") { startPos = { x, y }; }
                    else if (ch === "E") { 
                        const exit = this.add.rectangle(px, py, TILE, TILE, 0x2ecc71); 
                        exit.setStrokeStyle(2, 0x27ae60, 0.8); 
                        this.physics.add.existing(exit, true); 
                        this.exits.add(exit); 
                        this.tweens.add({ targets: exit, alpha: 0.6, duration: 1000, yoyo: true, repeat: -1 }); 
                    }
                    else if (ch === "C") { 
                        const coin = this.add.circle(px, py, TILE / 4, 0xf1c40f); 
                        coin.setStrokeStyle(2, 0xf39c12, 1); 
                        this.physics.add.existing(coin); 
                        this.coins.add(coin); 
                        this.tweens.add({ targets: coin, scaleX: 0.8, duration: 800, yoyo: true, repeat: -1 }); 
                    }
                    else if (ch === '.') {
                        if (currentLevel >= 19 && (x > 5 || y > 5)) {
                            const spawnChance = 0.02 + (currentLevel * 0.001);
                            if (Math.random() < spawnChance) {
                                const enemy = this.add.circle(px, py, TILE / 3, 0xe74c3c);
                                enemy.setStrokeStyle(2, 0xc0392b, 1);
                                this.physics.add.existing(enemy);
                                this.enemies.add(enemy);
                                const speed = 60;
                                enemy.body.setVelocity(Phaser.Math.Between(-speed, speed), Phaser.Math.Between(-speed, speed));
                            }
                        }
                    }
                }
            }
            const playerX = startPos.x * TILE + TILE / 2, playerY = startPos.y * TILE + TILE / 2;
            const currentSkin = SKINS.find(s => s.color === playerData.skin) || SKINS[0];
            this.player = this.add.rectangle(playerX, playerY, TILE * 0.8, TILE * 0.8, currentSkin.color);
            this.player.setStrokeStyle(2, 0xffffff, 0.6);
            this.physics.add.existing(this.player);
            this.player.body.setCollideWorldBounds(true);
            
            this.physics.add.collider(this.player, this.walls, this.handleWallCollision, null, this);
            this.physics.add.collider(this.enemies, this.walls);
            this.physics.add.overlap(this.player, this.enemies, this.handleWallCollision, null, this);

            this.physics.add.overlap(this.player, this.exits, this.showClearScreen, null, this);
            this.physics.add.overlap(this.player, this.coins, this.collectCoin, null, this);
        }

        setupAbility() {
            if (this.shieldTimer) { this.shieldTimer.destroy(); this.shieldTimer = null; }
            if (this.speedBoostTimer) { this.speedBoostTimer.destroy(); this.speedBoostTimer = null; }
            this.isInvincible = false; 
            const currentSkin = SKINS.find(s => s.color === playerData.skin) || SKINS[0];
            if (currentSkin.ability !== 'ninja') this.speedBoostMultiplier = 1.0;
            this.player.setAlpha(1.0);
            if (currentSkin.ability === 'shield' || currentSkin.ability === 'ultimate') { this.shieldTimer = this.time.addEvent({ delay: 8000, loop: true, callback: this.activateShield, callbackScope: this }); }
            if (currentSkin.ability === 'speed_boost' || currentSkin.ability === 'ultimate') { this.speedBoostTimer = this.time.addEvent({ delay: 10000, loop: true, callback: this.activateSpeedBoost, callbackScope: this }); }
        }
        
        activateShield() {
            if (this.isPlayerLocked || !this.player.body.enable) return;
            this.isInvincible = true;
            this.tweens.add({ targets: this.player, alpha: 0.4, duration: 200, yoyo: true, repeat: 7, onComplete: () => { this.isInvincible = false; this.player.setAlpha(1.0); } });
        }
        
        activateSpeedBoost() {
            if (this.isPlayerLocked || !this.player.body.enable) return;
            this.speedBoostMultiplier = 1.5;
            this.tweens.add({ targets: this.player, tint: 0xffff00, duration: 150, yoyo: true, repeat: 6, onComplete: () => { this.speedBoostMultiplier = 1.0; this.player.clearTint(); } });
            this.time.delayedCall(2000, () => { this.speedBoostMultiplier = 1.0; this.player.clearTint(); });
        }
        
        handleWallCollision() { 
            if (this.isInvincible) return; 
            const currentSkin = SKINS.find(s => s.color === playerData.skin) || SKINS[0];
            if (currentSkin.ability === 'evasion' && Math.random() < 0.2) {
                this.cameras.main.shake(100, 0.005);
                const dodgeText = this.add.text(this.player.x, this.player.y - 20, 'MISS!', { fontFamily: 'Do Hyeon', fontSize: '14px', color: '#2ecc71' }).setOrigin(0.5);
                this.tweens.add({ targets: dodgeText, y: this.player.y - 40, alpha: 0, duration: 500, onComplete: () => dodgeText.destroy() });
                return; 
            }
            this.restartLevel(); 
        }
        
        restartLevel() {
            if (gameMode === 'endless') {
                playerData.lives--;
                this.events.emit('updateUI');
                if (playerData.lives <= 0) {
                    this.playSFX(150, 'sawtooth'); this.isPlayerLocked = true; this.player.body.setEnable(false);
                    this.cameras.main.shake(400, 0.03); this.events.emit('gameOver'); return;
                }
            }
            if (this.shieldTimer) this.shieldTimer.destroy(); if (this.speedBoostTimer) this.speedBoostTimer.destroy();
            this.playSFX(220, 'triangle'); this.player.body.setEnable(false);
            this.cameras.main.shake(200, 0.01);
            this.cameras.main.fadeOut(250, 255, 0, 0).once('camerafadeoutcomplete', () => this.scene.restart());
        }

        update() {
            if (this.isPlayerLocked || !this.player.body.enable) { this.player.body.setVelocity(0); return; }
            const speed = (BASE_SPEED + (playerData.speedLevel * SPEED_UPGRADE.increment)) * this.speedBoostMultiplier;
            let vx = 0, vy = 0;
            if (this.cursors.left.isDown || this.keys.A.isDown) vx = -speed; else if (this.cursors.right.isDown || this.keys.D.isDown) vx = speed;
            if (this.cursors.up.isDown || this.keys.W.isDown) vy = -speed; else if (this.cursors.down.isDown || this.keys.S.isDown) vy = speed;
            this.player.body.setVelocity(vx, vy); if (vx && vy) this.player.body.velocity.normalize().scale(speed);

            if (gameMode === 'endless' && this.vision) {
                let visionRadius = VISION_BASE_RADIUS + (playerData.visionLevel * VISION_UPGRADE_INCREMENT);
                const currentSkin = SKINS.find(s => s.color === playerData.skin) || SKINS[0];
                if (currentSkin.ability === 'vision_plus' || currentSkin.ability === 'ultimate') { visionRadius *= 1.3; }
                else if (currentSkin.ability === 'ninja') { visionRadius *= 0.7; }
                this.vision.clear(); this.vision.fillStyle(0xffffff); this.vision.fillCircle(this.player.x, this.player.y, visionRadius);
            }
        }

        collectCoin(player, coin) {
            coin.body.setEnable(false);
            const currentSkin = SKINS.find(s => s.color === playerData.skin) || SKINS[0];
            let coinAmount = 1;
            if ((currentSkin.ability === 'coin_boost' || currentSkin.ability === 'ultimate') && Math.random() < 0.25) { 
                coinAmount = 2; 
                const bonusText = this.add.text(coin.x, coin.y - 20, '+1 BONUS!', { fontFamily: 'Do Hyeon', fontSize: '16px', color: '#f1c40f', stroke: '#000000', strokeThickness: 3 }).setScrollFactor(1);
                this.tweens.add({ targets: bonusText, y: coin.y - 40, alpha: 0, duration: 1000, onComplete: () => bonusText.destroy() });
            }
            if (currentSkin.ability === 'coin_magnet' && Math.random() < 0.1) { coinAmount = 3; }
            playerData.coins += coinAmount;
            this.tweens.add({ targets: coin, scaleX: 1.5, scaleY: 1.5, alpha: 0, duration: 200, onComplete: () => coin.destroy() });
            this.playSFX(880, 'sine', true); this.events.emit('updateUI');
        }

        showClearScreen() { 
            this.playSFX(523.25, 'sine', false, true);
            this.player.body.setEnable(false); this.cameras.main.flash(300, 46, 204, 113); this.events.emit('showClearScreen'); 
        }
        
        playSFX(freq, type, rampUp = false, success = false) {
            const ctx = this.sound.context; if (!ctx) return; if (ctx.state === 'suspended') ctx.resume();
            const osc = ctx.createOscillator(); const gain = ctx.createGain();
            osc.type = type; osc.connect(gain); gain.connect(ctx.destination);
            const now = ctx.currentTime; 
            const volume = 0.15 * sfxVolume; 
            gain.gain.setValueAtTime(volume, now); osc.frequency.setValueAtTime(freq, now);
            if (rampUp) { osc.frequency.exponentialRampToValueAtTime(freq * 1.5, now + 0.1); gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.15); osc.start(now); osc.stop(now + 0.15); }
            else if (success) { osc.frequency.setValueAtTime(523.25, now); osc.frequency.setValueAtTime(659.25, now + 0.1); osc.frequency.setValueAtTime(783.99, now + 0.2); osc.start(now); osc.stop(now + 0.3); }
            else { osc.frequency.exponentialRampToValueAtTime(50, now + 0.2); gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.2); osc.start(now); osc.stop(now + 0.2); }
        }
    }

