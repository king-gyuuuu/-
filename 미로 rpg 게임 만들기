            const title = this.add.text(centerX, centerY - 100, "🎉 클리어!", { fontFamily: 'Do Hyeon', fontSize: "56px", color: "#2ecc71", stroke: '#000000', strokeThickness: 6 }).setOrigin(0.5).setScale(0);
            this.tweens.add({ targets: title, scale: 1.2, duration: 500, ease: 'Elastic.easeOut' });
            this.add.text(centerX, centerY - 20, `레벨 ${currentLevel + 1} 완료!`, { fontFamily: 'Do Hyeon', fontSize: '28px', color: '#ecf0f1' }).setOrigin(0.5);
            const nextBtn = createButton(this, centerX + 100, centerY + 80, "➡️ 다음", { fontSize: "24px", backgroundColor: 0x3498db, hoverColor: 0x2980b9, padding: { x: 20, y: 10 } });
            
            nextBtn.on("pointerdown", () => { 
                currentLevel++; 
                this.cameras.main.fadeOut(300, 0, 0, 0); 
                this.time.delayedCall(300, () => this.gameScene.scene.restart()); 
            });

            const retryBtn = createButton(this, centerX - 100, centerY + 80, "🔄 다시하기", { fontSize: "24px", backgroundColor: 0xf39c12, hoverColor: 0xe67e22, padding: { x: 20, y: 10 } });
            retryBtn.on("pointerdown", () => { this.cameras.main.fadeOut(300, 0, 0, 0); this.time.delayedCall(300, () => this.gameScene.scene.restart()); });
        }
    }

    new Phaser.Game({
        type: Phaser.AUTO, parent: "game", width: 800, height: 600,
        physics: { default: "arcade", arcade: { debug: false } },
        scene: [PreloadScene, MainMenuScene, GameScene, UIScene],
        scale: { mode: Phaser.Scale.FIT, autoCenter: Phaser.Scale.CENTER_BOTH },
        render: { pixelArt: false }
    });
  </script>
</body>
</html>
