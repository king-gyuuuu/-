/*********************************************************************************

 * 프로그램 설명:
 * 1. 'inst.data' (명령어 테이블)와 'input.asm' (SIC 소스 코드)를 입력으로 받습니다.
 * 2. Pass 1:
 * - 소스 코드를 라인별로 파싱하여 token_table에 저장합니다.
 * - LOCCTR(주소 카운터)를 계산하여 각 라인의 주소를 할당합니다.
 * - 모든 Label을 찾아 주소와 함께 SYMTAB(심볼 테이블)에 저장합니다.
 * 3. Pass 2:
 * - SYMTAB과 inst_table을 참조하여 각 명령어 라인의 기계어 코드를 생성합니다.
 * 4. 'listing.txt' (출력 리스팅 파일)을 생성하여,
 * [주소] [원본 소스] [기계어 코드] 형식으로 출력합니다.
 *
 * 컴파일 (Visual Studio 개발자 프롬프트):
 * cl my_assembler.c /Fe:my_assembler.exe
 *
 *********************************************************************************/

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>


 // 1. 상수 및 구조체 선언 (과제 명세)
 
 // 과제 명세에 따른 최대값 정의
#define MAX_LINES 5000
#define MAX_OPERAND 2
#define MAX_INST 256

/**
 * @brief Instruction (명령어)의 정보를 저장하는 구조체
 */
struct inst_unit {
    char str[10];          // instruction의 이름 (e.g., "LDA")
    unsigned char op;      // 명령어의 OPCODE (e.g., 0x00)
    int format;            // instruction의 형식 (1, 2, 3) 또는 지시어(0)
    int ops;               // instruction의 operand 개수
};
typedef struct inst_unit inst;
inst* inst_table[MAX_INST]; // Instruction 테이블 (해시 테이블 대신 배열로 구현)
int inst_index = 0;         // inst_table의 현재 크기

/**
 * @brief 파싱된 한 줄의 소스 코드를 토큰 단위로 저장하는 구조체
 */
struct token_unit {
    char* label;                       // Label 필드 (없으면 NULL)
    char* operator;                    // Operator 필드 (명령어 또는 지시어)
    char operand[MAX_OPERAND][20]; // Operand 필드 (최대 2개, e.g., "BUFFER", "X")
    char comment[100];              // 주석 (본 과제에서는 사용X)
    int location;                      // Pass 1에서 계산된 주소 (LOCCTR)
    int obj_code;                      // Pass 2에서 생성된 기계어 코드
    int is_comment_line;               // '.'으로 시작하는 주석 라인 여부 (1: true)
};
typedef struct token_unit token;
token* token_table[MAX_LINES];     // 토큰 테이블 (라인 번호 = 인덱스)

// 1-3. 소스코드 관리 테이블
char* input_data[MAX_LINES]; // 원본 소스코드 라인별 저장
int line_num = 0;            // 전체 라인 수

/**
 * @brief Symbol (레이블)의 이름과 주소를 저장하는 구조체
 */
struct symbol_unit {
    char symbol[10]; // 심볼 이름
    int address;      // 심볼의 주소
};
typedef struct symbol_unit sym;
sym* sym_table[MAX_LINES]; // 심볼 테이블 (해시 테이블 대신 배열로 구현)
int sym_count = 0;         // 심볼 개수

// 1-5. 어셈블러 관리를 위한 전역 변수
int locctr;        // Location Counter (주소 계산기)
int start_address; // 시작 주소
int program_length; // 프로그램 전체 길이

// 2. 헬퍼 함수 선언 (Function Prototypes)

void init_inst_table(const char* filename);
void read_source_file(const char* filename);
inst* search_inst(const char* operator);
sym* search_sym(const char* symbol);
int add_sym(const char* symbol, int address);
void parse_line(int index);
void pass_one();
void pass_two();
void print_listing_file(const char* filename);
void free_all_memory();

// 3. main 함수 (Orchestrator)

int main() {
    const char* inst_file = "inst.data";
    const char* input_file = "input.asm";
    const char* output_file = "listing.txt"; // 2.2 형식의 출력 파일

    // 1단계: inst.data를 읽어 inst_table 초기화
    init_inst_table(inst_file);

    // 2단계: input.asm을 읽어 input_data에 저장
    read_source_file(input_file);

    // 3단계: Pass 1 수행 (파싱, 주소 계산, SYMTAB 생성)
    pass_one();

    // 4단계: Pass 2 수행 (기계어 코드 생성)
    pass_two();

    // 5단계: 2.2 형식으로 listing.txt 파일 출력
    print_listing_file(output_file);

    // 6단계: 할당된 메모리(malloc, strdup) 해제
    free_all_memory();

    printf("어셈블리 완료. '%s' 파일이 생성되었습니다.\n", output_file);

    return 0;
}

// 4. 헬퍼 함수 구현 (Implementations)

/**
 * @brief inst.data 파일을 읽어 inst_table을 초기화합니다.
 * @param filename 'inst.data' 파일 경로
 */
void init_inst_table(const char* filename) {
    FILE* fp = fopen(filename, "r");
    if (fp == NULL) {
        perror("Error: 'inst.data' 파일을 열 수 없습니다.");
        exit(1);
    }

    // (이름, 형식문자, 포맷, Opcode)
    char name[10], format_str[10];
    int format, opcode;

    // 파일 끝까지 한 줄씩 읽음 (형식: ADD M 3 18)
    while (fscanf(fp, "%s %s %d %x", name, format_str, &format, &opcode) != EOF) {
        inst_table[inst_index] = (inst*)malloc(sizeof(inst));

        // 1. 이름, Opcode, 포맷 저장
        strcpy(inst_table[inst_index]->str, name);
        inst_table[inst_index]->op = (unsigned char)opcode;
        inst_table[inst_index]->format = format;

        // 2. 형식 문자를 기반으로 Operand 개수(ops) 추론
        // M(Memory), R(Register), N(Number) -> 1개
        if (strcmp(format_str, "M") == 0 || strcmp(format_str, "R") == 0 || strcmp(format_str, "N") == 0) {
            inst_table[inst_index]->ops = 1;
        }
        // RR(Register-Register), RN(Register-Number) -> 2개
        else if (strcmp(format_str, "RR") == 0 || strcmp(format_str, "RN") == 0) {
            inst_table[inst_index]->ops = 2;
        }
        // -(None) -> 0개 (e.g., RSUB, FIX, ...)
        else if (strcmp(format_str, "-") == 0) {
            inst_table[inst_index]->ops = 0;
        }
        else {
            // (지시어 BYTE, WORD 등은 'M'으로 되어있으나, 
            //  Pass 2에서 ops 필드를 참조하지 않으므로 1로 두어도 무방)
            inst_table[inst_index]->ops = 1;
        }

        inst_index++;
    }

    fclose(fp);
}


/**
 * @brief input.asm 파일을 읽어 input_data 배열에 한 줄씩 저장합니다.
 * @param filename 'input.asm' 파일 경로
 */
void read_source_file(const char* filename) {
    FILE* fp = fopen(filename, "r");
    if (fp == NULL) {
        perror("Error: 'input.asm' 파일을 열 수 없습니다.");
        exit(1);
    }

    char buffer[256];
    while (fgets(buffer, sizeof(buffer), fp) != NULL && line_num < MAX_LINES) {
        // strdup: 문자열을 복사할 새 메모리를 할당(malloc + strcpy)하고 포인터를 반환
        input_data[line_num] = strdup(buffer);
        line_num++;
    }

    fclose(fp);
}

/**
 * @brief inst_table에서 operator(명령어)를 선형 검색하여 반환합니다.
 * @param operator 검색할 명령어 문자열 (e.g., "LDA")
 * @return 찾은 inst 구조체 포인터 (없으면 NULL)
 */
inst* search_inst(const char* operator) {
    if (operator == NULL) return NULL;
    for (int i = 0; i < inst_index; i++) {
        if (strcmp(inst_table[i]->str, operator) == 0) {
            return inst_table[i];
        }
    }
    return NULL; // 못 찾음
}

/**
 * @brief sym_table에서 symbol(레이블)을 선형 검색하여 반환합니다.
 * @param symbol 검색할 심볼 문자열 (e.g., "BUFFER")
 * @return 찾은 sym 구조체 포인터 (없으면 NULL)
 */
sym* search_sym(const char* symbol) {
    if (symbol == NULL) return NULL;
    for (int i = 0; i < sym_count; i++) {
        if (strcmp(sym_table[i]->symbol, symbol) == 0) {
            return sym_table[i];
        }
    }
    return NULL; // 못 찾음
}

/**
 * @brief sym_table에 새로운 symbol을 추가합니다. (중복 검사 포함)
 * @param symbol 추가할 심볼 이름
 * @param address 해당 심볼의 주소
 * @return 성공 시 0, 중복 오류 시 -1
 */
int add_sym(const char* symbol, int address) {
    if (symbol == NULL) return 0; // Label이 없는 라인

    if (search_sym(symbol) != NULL) {
        // 중복된 심볼 오류
        printf("Error: Symbol '%s' is duplicated.\n", symbol);
        return -1; // 오류
    }

    sym_table[sym_count] = (sym*)malloc(sizeof(sym));
    strcpy(sym_table[sym_count]->symbol, symbol);
    sym_table[sym_count]->address = address;
    sym_count++;

    return 0; // 성공
}

/**
 * @brief 한 줄의 소스코드(input_data[index])를 파싱하여 token_table[index]에 저장
 * @param index 파싱할 라인의 번호 (input_data/token_table 인덱스)
 */
void parse_line(int index) {
    // 토큰 구조체 메모리 할당
    token_table[index] = (token*)malloc(sizeof(token));
    token* tok = token_table[index];

    // 구조체 멤버 초기화
    tok->label = NULL;
    tok->operator = NULL;
    tok->operand[0][0] = '\0';
    tok->operand[1][0] = '\0';
    tok->comment[0] = '\0';
    tok->location = 0;
    tok->obj_code = -1; // -1: 기계어 코드 아직 생성 안됨
    tok->is_comment_line = 0;

    // 원본 라인 복사 (strtok 함수는 원본 문자열을 수정하므로)
    char* line_copy = strdup(input_data[index]);
    char* original_line_ptr = line_copy; // free를 위해 원본 포인터 저장

    // 줄바꿈 문자(\n) 제거 (파싱 방해 요소)
    line_copy[strcspn(line_copy, "\n")] = 0;

    // 1. '.' 주석 라인 처리 (교수님 요구사항)
    if (line_copy[0] == '.') {
        tok->is_comment_line = 1;
        strcpy(tok->comment, line_copy);
        free(original_line_ptr); // 복사본 해제
        return;
    }

    // 2. 토큰 분리를 위한 구분자 (공백과 탭)
    const char* delimiters = " \t";
    char* token_str;

    // 3. Label / Operator / Operand 구분
    // SIC 표준: 첫 번째 칸(index 0)이 공백/탭이 아니면 Label
    if (input_data[index][0] != ' ' && input_data[index][0] != '\t') {
        // Label이 있는 경우
        token_str = strtok(line_copy, delimiters);
        if (token_str) tok->label = strdup(token_str); // strdup으로 별도 메모리에 저장

        // 다음 토큰 (Operator)
        token_str = strtok(NULL, delimiters);
        if (token_str) tok->operator = strdup(token_str);
    }
    else {
        // Label이 없는 경우 (첫 토큰이 Operator)
        token_str = strtok(line_copy, delimiters);
        if (token_str) tok->operator = strdup(token_str);
    }

    // 4. Operand 파싱
    token_str = strtok(NULL, delimiters);
    if (token_str) {
        // (참고: 일반 주석도 무시)
        char* comment_ptr = strchr(token_str, '.');
        if (comment_ptr) *comment_ptr = '\0'; // 주석 시작 부분을 NULL로 잘라냄

        // Operand가 'BUFFER,X' 처럼 콤마로 구분된 경우
        char* comma_ptr = strchr(token_str, ',');
        if (comma_ptr) {
            *comma_ptr = '\0'; // 콤마를 NULL 문자로 대체하여 분리
            strcpy(tok->operand[0], token_str);      // "BUFFER"
            strcpy(tok->operand[1], comma_ptr + 1); // "X"
        }
        else {
            // Operand가 하나인 경우
            strcpy(tok->operand[0], token_str);
        }
    }

    // 5. 남은 주석 파싱 (과제에선 출력 안하지만, 구조상 포함)
    token_str = strtok(NULL, ""); // 나머지 문자열 전체
    if (token_str) {
        while (isspace((unsigned char)*token_str)) token_str++; // 앞쪽 공백 제거
        strcpy(tok->comment, token_str);
    }

    free(original_line_ptr); // 복사본 해제
}


/**
 * @brief Pass 1: 주소 계산 및 심볼 테이블 생성을 수행합니다.
 * 모든 라인을 파싱하고, LOCCTR를 계산하며, Label을 SYMTAB에 추가합니다.
 */
void pass_one() {
    int i;
    // 1. 모든 라인을 파싱하여 token_table 생성
    for (i = 0; i < line_num; i++) {
        parse_line(i);
    }

    // 2. "START" 지시어를 찾아 시작 주소(locctr) 설정
    i = 0;
    while (i < line_num) {
        token* tok = token_table[i];
        if (tok->is_comment_line) { // 주석 라인 건너뛰기
            i++;
            continue;
        }

        // "START"는 inst.data에서 Opcode 0x01로 정의됨
        inst* op_inst = search_inst(tok->operator);
        if (op_inst && op_inst->op == 0x01) { // 0x01 = START
            // Operand에 적힌 16진수 문자열을 정수로 변환하여 시작 주소로 설정
            start_address = (int)strtol(tok->operand[0], NULL, 16);
            locctr = start_address;
            tok->location = locctr; // START 라인의 주소

            // "START" 라인에 Label(프로그램 이름)이 있으면 SYMTAB에 추가
            if (tok->label) {
                add_sym(tok->label, locctr);
            }
            break; // START 찾았으므로 탐색 중지
        }
        i++;
    }

    // 3. "START" 다음 라인부터 "END"까지 주소 계산
    for (i = i + 1; i < line_num; i++) {
        token* tok = token_table[i];

        // '.' 주석 라인은 건너뜀 (주소 할당 없음)
        if (tok->is_comment_line) {
            continue;
        }

        // "END" 만나면 Pass 1 종료 (END는 0x0E)
        if (tok->operator && strcmp(tok->operator, "END") == 0) {
            tok->location = locctr;
            break;
        }

        // 현재 라인의 주소로 locctr 할당
        tok->location = locctr;

        // Label이 있으면 (e.g., "FIRST", "CLOOP", ...) SYMTAB에 (이름, 주소) 쌍 추가
        if (tok->label) {
            if (add_sym(tok->label, locctr) == -1) {
                // 중복 심볼 오류 시 종료
                exit(1);
            }
        }

        // Operator 종류에 따라 locctr 증가
        inst* op_inst = search_inst(tok->operator);

        if (op_inst == NULL) {
            // inst.data에 없는 명령어 (오류)
            printf("Error: Invalid operator '%s' at line %d\n", tok->operator, i + 1);
            exit(1);
        }

        // 1. Instruction인 경우 (format 1, 2, 3)
        // (기본 SIC는 모두 format 3이지만, XE 호환성을 위해 format 값 사용)
        if (op_inst->format == 1 || op_inst->format == 2 || op_inst->format == 3) {
            locctr += op_inst->format;
        }
        // 2. Directive(지시어)인 경우 (format 0)
        else if (op_inst->format == 0) {
            // inst.data의 Opcode 값을 기준으로 어떤 지시어인지 판별
            switch (op_inst->op) {
            case 0x0D: // WORD (항상 3바이트)
                locctr += 3;
                break;
            case 0x05: // RESW (n * 3바이트)
                locctr += 3 * atoi(tok->operand[0]); // operand[0] (e.g., "1")
                break;
            case 0x06: // RESB (n * 1바이트)
                locctr += atoi(tok->operand[0]); // operand[0] (e.g., "4096")
                break;
            case 0x0B: // BYTE
                if (tok->operand[0][0] == 'C') { // C'EOF'
                    locctr += (strlen(tok->operand[0]) - 3); // C'' 3글자 제외
                }
                else if (tok->operand[0][0] == 'X') { // X'F1'
                    locctr += (strlen(tok->operand[0]) - 3) / 2; // X'' 3글자 제외, 2글자당 1바이트
                }
                break;

                // 그 외 START, END, EQU 등은 locctr에 영향 없음
            case 0x01: // START (이미 처리됨)
            case 0x0E: // END (처리 필요 없음)
            case 0x09: // EQU
            case 0x0A: // CSECT
            case 0x07: // LTORG
                break;
            }
        }
    } // end for loop

    // 4. 전체 프로그램 길이 계산
    program_length = locctr - start_address;
}


/**
 * @brief Pass 2: 기계어 코드 생성을 수행합니다.
 * token_table을 순회하며 SYMTAB과 inst_table을 참조하여
 * obj_code를 생성하고 token->obj_code에 저장합니다.
 */
void pass_two() {
    for (int i = 0; i < line_num; i++) {
        token* tok = token_table[i];

        // 기계어 생성이 필요 없는 라인들 (주석, 지시어 등)
        if (tok->is_comment_line || tok->operator == NULL) {
            tok->obj_code = -1; // -1: 기계어 없음
            continue;
        }

        int obj = 0; // 24비트(6-hex) 기계어 코드를 임시 저장할 변수

        inst* op_inst = search_inst(tok->operator);
        if (op_inst == NULL) {
            // (Pass 1에서 이미 검사했으므로 발생하지 않아야 함)
            continue;
        }

        // 1. Instruction (format 1, 2, 3) (e.g., LDA, STL, J, ...)
        if (op_inst->format > 0) {
            // 1-1. Opcode (상위 8비트)
            // e.g., STL(0x14) -> 0x140000
            obj = (op_inst->op) << 16;

            // 1-2. Operand 주소 (하위 16비트)
            if (op_inst->ops > 0) { // Operand가 있는 명령어 (RSUB 제외)

                // SYMTAB에서 Operand(e.g., "RETADR")의 주소를 검색
                sym* op_sym = search_sym(tok->operand[0]);

                if (op_sym == NULL) {
                    // 'RSUB'는 operand가 없지만 ops=0이므로 이 if문을 통과함 (정상)
                    if (op_inst->ops > 0) {
                        // (예제 17라인 J @RETADR: @RETADR는 심볼이 아님)
                        printf("Error: Undefined symbol '%s' at line %d\n", tok->operand[0], i + 1);
                        tok->obj_code = -2; // -2: 오류
                        continue;
                    }

                }
                else {
                    // 1-2-1. 심볼의 주소 가져오기 (e.g., RETADR -> 1033)
                    int address = op_sym->address;

                    // 1-2-2. 인덱스 모드 (',X') 처리 (e.g., BUFFER,X)
                    if (tok->operand[1][0] == 'X') {
                        // X 비트(15번째 비트)를 1로 세팅 (0x8000 = 1000 0000 0000 0000)
                        address |= 0x8000; // e.g., 1039 -> 9039
                    }

                    // 1-2-3. 주소를 하위 16비트에 더함
                    obj += address; // e.g., 0x140000 + 0x1033 = 0x141033
                }
            }
            // (RSUB 같이 Operand가 없는 명령어는 obj = (0x4C << 16) + 0 = 4C0000)
        }
        // 2. Data (WORD, BYTE) (format 0)
        else {
            switch (op_inst->op) {
            case 0x0D: // WORD (e.g., 3)
                obj = atoi(tok->operand[0]); // "3" -> 3
                break;
            case 0x0B: // BYTE
                if (tok->operand[0][0] == 'C') { // C'EOF'
                    // 문자들을 ASCII 코드로 변환하여 3바이트로 조합
                    char c1 = tok->operand[0][2]; // 'E'
                    char c2 = (strlen(tok->operand[0]) > 4) ? tok->operand[0][3] : 0; // 'O'
                    char c3 = (strlen(tok->operand[0]) > 5) ? tok->operand[0][4] : 0; // 'F'
                    // (E, O, F) -> (0x45, 0x4F, 0x46) -> 0x454F46
                    obj = (c1 << 16) + (c2 << 8) + c3;
                }
                else if (tok->operand[0][0] == 'X') { // X'F1'
                    // 16진수 문자열(e.g., "F1")을 정수(0xF1)로 변환
                    char hex_str[10] = { 0 };
                    strncpy(hex_str, tok->operand[0] + 2, strlen(tok->operand[0]) - 3); // "F1"
                    obj = (int)strtol(hex_str, NULL, 16); // "F1" -> 241 (0xF1)
                }
                break;
            default:
                // RESW, RESB, START, END 등은 기계어 없음
                obj = -1;
                break;
            }
        }

        tok->obj_code = obj; // 완성된 기계어 코드를 토큰에 저장
    }
}


/**
 * @brief 최종 결과(listing 파일)를 교재 2.2 형식으로 출력합니다.
 * @param filename "listing.txt" 파일 경로
 */
void print_listing_file(const char* filename) {
    FILE* fp = fopen(filename, "w");
    if (fp == NULL) {
        perror("Error: 출력 파일을 생성할 수 없습니다.");
        exit(1);
    }

    // 모든 라인을 순회하며 출력
    for (int i = 0; i < line_num; i++) {
        token* tok = token_table[i];

        // 1. '.' 주석 라인은 출력 안함 (교수님 요구사항)
        if (tok->is_comment_line) {
            continue;
        }

        // 2. 주소 출력 (16진수 4자리, 대문자)
        if (tok->operator && strcmp(tok->operator, "START") == 0) {
            fprintf(fp, "%04X\t", tok->location);
        }
        else if (tok->operator) {
            fprintf(fp, "%04X\t", tok->location);
        }
        else {
            fprintf(fp, "    \t"); // 주소 없는 라인 (e.g., END)
        }

        // 3. 원본 소스 코드 출력 (Label, Operator, Operand)
        // 주석(Comment)은 출력 안함
        // %-8s : 8칸을 확보하고 왼쪽 정렬
        fprintf(fp, "%-8s\t", tok->label ? tok->label : "");
        fprintf(fp, "%-8s\t", tok->operator ? tok->operator : "");

        // Operand가 2개인 경우 (e.g., BUFFER,X) 콤마를 붙여서 출력
        if (tok->operand[1][0] != '\0') {
            // strdup을 사용해 임시 문자열을 만들어 strcat으로 합침
            // (원본 tok->operand[0]가 수정되는 것을 방지)
            char temp_op[30];
            strcpy(temp_op, tok->operand[0]);
            strcat(temp_op, ",");
            strcat(temp_op, tok->operand[1]);
            fprintf(fp, "%-10s\t", temp_op);
        }
        else {
            fprintf(fp, "%-10s\t", tok->operand[0]);
        }

        // 4. 기계어 코드 출력
        if (tok->obj_code == -2) {
            // Pass 2에서 발생한 오류 (e.g., Undefined Symbol)
            fprintf(fp, "ERROR: UNDEFINED SYMBOL");
        }
        else if (tok->obj_code >= 0) {
            // %06X : 6자리 16진수, 대문자, 빈칸은 0으로 채움
            fprintf(fp, "%06X", tok->obj_code);
        }
        // (obj_code == -1인 RESW, RESB 등은 아무것도 출력하지 않음)

        fprintf(fp, "\n");
    }

    fclose(fp);
}

/**
 * @brief 동적 할당된(malloc, strdup) 모든 메모리를 해제합니다.
 */
void free_all_memory() {
    int i;
    // inst_table 해제
    for (i = 0; i < inst_index; i++) {
        free(inst_table[i]);
    }

    // input_data 해제 (strdup으로 할당됨)
    for (i = 0; i < line_num; i++) {
        free(input_data[i]);
    }

    // token_table 및 내부 포인터 해제
    for (i = 0; i < line_num; i++) {
        if (token_table[i]) {
            free(token_table[i]->label); // strdup으로 할당됨
            free(token_table[i]->operator); // strdup으로 할당됨
            free(token_table[i]); // token_unit 구조체 자체
        }
    }

    // sym_table 해제
    for (i = 0; i < sym_count; i++) {
        free(sym_table[i]);
    }
}
